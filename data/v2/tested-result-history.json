{
  "project": "Vectis lets weld",
  "app": "AI-Weld Settings Library / Vectis Weld Recipe Control",
  "version": "V2",
  "milestone": "V2-M5 — Tested Result History Structure",
  "purpose": "Create the V2 tested result history structure for recording what actually happened when a baseline range or test coupon is welded and evaluated.",
  "locked_context": {
    "v1_status": "complete_closed",
    "v2_m1_status": "locked_passed",
    "v2_m2_status": "locked_passed",
    "v2_m3_status": "locked_passed",
    "v2_m4_status": "locked_passed",
    "core_rule": "Baseline range = starting reference only. Tested result = what actually happened. Locked recipe = approved production record.",
    "required_control_path": "Baseline Range → Test Coupon → Tested Result → Approval → Locked Recipe"
  },
  "scope_rules": {
    "material_scope": "Mild steel only",
    "allowed_processes": ["MIG", "Pulse MIG"],
    "machine_scope": "Vectis cobot",
    "welder_scope": "Miller 352 MPa",
    "tested_result_history_structure_only": true,
    "recommendation_logic": false,
    "ranking_allowed": false,
    "production_ready_baseline_claims_allowed": false,
    "excluded": ["stainless", "aluminum", "flux-core", "metal-core"]
  },
  "required_fields": [
    "tested_result_id",
    "baseline_range_id",
    "test_coupon_id",
    "recipe_attempt_id",
    "test_date",
    "operator",
    "job_number",
    "job_name",
    "part_description",
    "part_number",
    "material",
    "thickness",
    "joint_type",
    "weld_position",
    "wire_type",
    "wire_diameter",
    "gas",
    "mode",
    "wfs",
    "voltage_or_trim",
    "travel_speed",
    "weave_type",
    "weave_parameters",
    "ctwd",
    "torch_angle",
    "fit_up_condition",
    "visual_result",
    "tie_in_result",
    "undercut_result",
    "overlap_result",
    "spatter_result",
    "porosity_result",
    "burn_through_result",
    "distortion_result",
    "penetration_result",
    "pass_fail",
    "notes",
    "photo_evidence_available",
    "photo_evidence_reference",
    "approval_required",
    "approved_by",
    "approval_date",
    "linked_locked_recipe_id",
    "production_ready"
  ],
  "field_groups": {
    "result_identification": ["tested_result_id", "recipe_attempt_id", "test_date", "operator"],
    "traceability": ["baseline_range_id", "test_coupon_id", "job_number", "job_name", "part_description", "part_number"],
    "weld_settings_used": ["material", "thickness", "joint_type", "weld_position", "wire_type", "wire_diameter", "gas", "mode", "wfs", "voltage_or_trim", "travel_speed", "weave_type", "weave_parameters", "ctwd", "torch_angle"],
    "fit_up_conditions": ["fit_up_condition"],
    "inspection_results": ["visual_result", "tie_in_result", "undercut_result", "overlap_result", "spatter_result", "porosity_result", "burn_through_result", "distortion_result", "penetration_result"],
    "pass_fail": ["pass_fail"],
    "photo_evidence": ["photo_evidence_available", "photo_evidence_reference"],
    "approval_linkage": ["approval_required", "approved_by", "approval_date", "linked_locked_recipe_id", "production_ready"],
    "notes": ["notes"]
  },
  "traceability_rule": {
    "job_number_optional": true,
    "minimum_required_traceable_identifier_count": 1,
    "accepted_traceable_identifiers": [
      "job_number",
      "job_name",
      "part_description",
      "part_number",
      "test_coupon_id"
    ],
    "rule": "Every tested result must include at least one traceable identifier so the result is not orphaned."
  },
  "required_defaults": {
    "approval_required": true,
    "linked_locked_recipe_id": null,
    "production_ready": false
  },
  "result_rules": {
    "tested_result_auto_approval_allowed": false,
    "passing_test_auto_locked_recipe_allowed": false,
    "approval_required_before_locked_recipe": true,
    "tested_result_can_be_called_best_or_ideal": false,
    "tested_result_can_be_production_ready_without_lock": false,
    "rule": "Tested results record what happened during the weld test. They do not automatically approve, recommend, rank, or lock a recipe."
  },
  "tested_result_records": []
}
