{
  "project": "Vectis lets weld",
  "app": "AI-Weld Settings Library / Vectis Weld Recipe Control",
  "version": "V2",
  "milestone": "V2-M8 — Floor-Side Program Setup Helper Structure",
  "purpose": "Create the V2 floor-side program setup helper structure for using the app on the shop floor while writing or adjusting a Vectis weld program without requiring computer access.",
  "use_case": "A user is at the Vectis cobot / Miller 352 MPa and needs a quick structured helper to select mild steel setup context, view reference-only baseline guidance, enter actual machine/cobot settings being tried, create or link a test coupon, record what worked or failed, and preserve tested results for future learning.",
  "locked_context": {
    "v1_status": "complete_closed",
    "v2_m1_through_m7_status": "locked_passed",
    "baseline_range_rule": "Baseline ranges remain reference-only.",
    "search_filter_rule": "Search/filter finds reference data only.",
    "locked_recipe_rule": "Locked recipes require tested result, approval, and lock authorization.",
    "core_rule": "Baseline range = starting reference only. Tested result = what actually happened. Locked recipe = approved production record."
  },
  "scope_rules": {
    "material_scope": "Mild steel only",
    "allowed_processes": ["MIG", "Pulse MIG"],
    "machine_scope": "Vectis cobot",
    "welder_scope": "Miller 352 MPa",
    "floor_side_helper_structure_only": true,
    "print_export_reference_sheet_logic": false,
    "recommendation_logic": false,
    "ranking_allowed": false,
    "auto_select_settings_allowed": false,
    "production_ready_baseline_claims_allowed": false,
    "real_baseline_range_data_allowed": false,
    "excluded": ["stainless", "aluminum", "flux-core", "metal-core"]
  },
  "helper_sections": {
    "setup_context": [
      "material",
      "thickness",
      "gauge",
      "joint_type",
      "weld_position",
      "wire_type",
      "wire_diameter",
      "gas",
      "mode",
      "operator",
      "date",
      "traceable_identifier_type",
      "traceable_identifier_value"
    ],
    "baseline_reference": [
      "baseline_range_id",
      "source_label",
      "confidence_level",
      "baseline_status",
      "requiresTestCoupon",
      "reference_notes",
      "safety_labels"
    ],
    "actual_settings_being_tried": [
      "wfs",
      "voltage_or_trim",
      "travel_speed",
      "ctwd",
      "torch_work_angle",
      "push_pull_angle",
      "weave_type",
      "weave_parameters",
      "pass_count",
      "notes"
    ],
    "cobot_motion_weave_setup": [
      "cobot_program_name",
      "program_step_or_weld_number",
      "weave_type",
      "weave_parameters",
      "travel_speed",
      "torch_work_angle",
      "push_pull_angle",
      "motion_notes"
    ],
    "test_coupon_trial_weld": [
      "test_coupon_id",
      "create_test_coupon_action",
      "link_existing_test_coupon_action",
      "test_status"
    ],
    "result_capture": [
      "visual_result",
      "tie_in_result",
      "undercut_result",
      "overlap_result",
      "spatter_result",
      "porosity_result",
      "burn_through_result",
      "distortion_result",
      "penetration_result",
      "pass_fail",
      "photo_evidence_available",
      "photo_evidence_reference",
      "result_notes"
    ],
    "save_review_later": [
      "save_as_tested_result_action",
      "review_later_status",
      "approval_required",
      "linked_locked_recipe_id",
      "production_ready"
    ]
  },
  "required_setup_context_fields": [
    "material",
    "thickness",
    "gauge",
    "joint_type",
    "weld_position",
    "wire_type",
    "wire_diameter",
    "gas",
    "mode",
    "operator",
    "date",
    "traceable_identifier_type",
    "traceable_identifier_value"
  ],
  "required_actual_setting_fields": [
    "wfs",
    "voltage_or_trim",
    "travel_speed",
    "ctwd",
    "torch_work_angle",
    "push_pull_angle",
    "weave_type",
    "weave_parameters",
    "pass_count",
    "notes"
  ],
  "required_test_result_fields": [
    "test_coupon_id",
    "test_status",
    "visual_result",
    "tie_in_result",
    "undercut_result",
    "overlap_result",
    "spatter_result",
    "porosity_result",
    "burn_through_result",
    "distortion_result",
    "penetration_result",
    "pass_fail",
    "photo_evidence_available",
    "photo_evidence_reference",
    "result_notes"
  ],
  "required_safety_labels": [
    "Reference Only",
    "Requires Test Coupon",
    "Not Approved",
    "Not Production Ready",
    "Not Locked Recipe"
  ],
  "defaults": {
    "baseline_status": "REFERENCE_ONLY",
    "requiresTestCoupon": true,
    "approval_required": true,
    "linked_locked_recipe_id": null,
    "production_ready": false
  },
  "action_rules": {
    "create_test_coupon_action": "placeholder_or_linkage_action_only",
    "save_as_tested_result_action": "records what happened, not approval",
    "approval_from_helper_allowed": false,
    "lock_from_helper_allowed": false,
    "production_ready_from_helper_allowed": false,
    "recommendation_from_helper_allowed": false,
    "auto_select_from_helper_allowed": false
  },
  "helper_boundary": "This is a shop-floor setup helper, not a print/export sheet, approved weld procedure, recommendation engine, or locked recipe generator."
}
