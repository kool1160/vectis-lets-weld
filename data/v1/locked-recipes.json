{
  "project": "Vectis lets weld",
  "app": "AI-Weld Settings Library / Vectis Weld Recipe Control",
  "version": "V1",
  "milestone": "V1-M7 — Locked Recipe Library Structure",
  "purpose": "Store only tested, approved, production-ready mild steel weld recipes for reuse.",
  "machine_scope": {
    "cobot": "Vectis cobot",
    "welder": "Miller 352 MPa"
  },
  "scope_rules": {
    "material_scope": "Mild steel only",
    "allowed_processes": ["MIG", "Pulse MIG"],
    "allowed_wire": [".035 ER70S-6", ".045 ER70S-6"],
    "allowed_gas": "Shop-used mild steel gas only",
    "excluded": ["stainless", "aluminum", "flux-core", "metal-core"],
    "recommendation_logic": false,
    "workflow": "Collect → Test → Approve → Lock → Reuse"
  },
  "required_fields": [
    "locked_recipe_id",
    "recipe_name",
    "baseline_id",
    "test_coupon_id",
    "approval_record_id",
    "material",
    "thickness",
    "joint_type",
    "weld_position",
    "process",
    "wire_type",
    "wire_diameter",
    "gas",
    "voltage_or_trim",
    "wire_feed_speed",
    "amperage_if_available",
    "travel_speed_ipm",
    "stickout",
    "torch_angle",
    "work_angle",
    "weave_pattern",
    "weave_width",
    "weave_dwell",
    "pass_count",
    "approved_by",
    "approved_date",
    "lock_authorized_by",
    "lock_date",
    "production_ready",
    "revision",
    "active_status",
    "notes"
  ],
  "locked_recipe_controls": {
    "baseline_rows_allowed": false,
    "test_coupon_rows_allowed": false,
    "required_test_status": "test_passed",
    "required_approval_status": "approved_for_lock",
    "required_production_ready": true,
    "traceability_required": ["baseline_id", "test_coupon_id", "approval_record_id"],
    "locked_recipe_rule": "A locked recipe must trace back to a passed test coupon and an approval record approved for lock.",
    "production_ready_rule": "production_ready may only be true inside the locked recipe library after approval and intentional lock authorization."
  },
  "locked_recipes": []
}
